[Unit]
Description=WPA supplicant daemon (interface-specific version)
BindsTo=sys-subsystem-net-devices-%i.device
After=sys-subsystem-net-devices-%i.device
Before=network.target
Wants=network.target

# check existence of configuration file
ConditionPathExists=/opt/redpitaya/wpa_supplicant.conf
# ...and that we are not configured as an access point. hostapd@.service already
# refuses to start when wpa_supplicant.conf is present; without the mirror image
# of that condition here, a board with both files started the supplicant instead
# of refusing the ambiguous configuration.
ConditionPathExists=!/opt/redpitaya/hostapd.conf

# NetworkManager users will probably want the dbus version instead.

[Service]
Type=simple

# Only for cfg80211/nl80211 adapters; legacy wireless-extensions-only adapters
# are handled by wpa_supplicant_wext@.service. A non-zero ExecCondition marks
# the unit skipped rather than failed, so both units stay enabled and exactly
# one of them proceeds.
ExecCondition=/usr/local/sbin/rp-wireless-driver is-nl80211 %I

# /etc/wpa_supplicant/wpa_supplicant.conf is a symlink to this file (see
# debian/network.sh); reference the real path so the config used and the
# condition above are visibly the same file.
ExecStart=/sbin/wpa_supplicant -c/opt/redpitaya/wpa_supplicant.conf -i%I
Restart=on-failure
RestartSec=5

[Install]
WantedBy=sys-subsystem-net-devices-%i.device
