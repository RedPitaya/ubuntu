[Unit]
Description=WPA supplicant daemon, wireless-extensions driver (interface-specific version)
Documentation=man:wpa_supplicant(8)
BindsTo=sys-subsystem-net-devices-%i.device
After=sys-subsystem-net-devices-%i.device
Before=network.target
Wants=network.target

# check existence of configuration file
ConditionPathExists=/opt/redpitaya/wpa_supplicant.conf
ConditionPathExists=!/opt/redpitaya/hostapd.conf

[Service]
Type=simple

# Only for adapters whose driver predates cfg80211 - out-of-tree rtl8188eu and
# similar. A non-zero ExecCondition marks the unit skipped, not failed, so this
# and wpa_supplicant@.service can both be enabled and exactly one runs.
ExecCondition=/usr/local/sbin/rp-wireless-driver is-wext %I

# These drivers want Managed mode and the ESSID set before the supplicant
# attaches over wext. This is the one step netstart.service used to perform.
ExecStartPre=/usr/local/sbin/rp-wireless-driver wext-preset %I

ExecStart=/sbin/wpa_supplicant -c/opt/redpitaya/wpa_supplicant.conf -i%I -D wext
Restart=on-failure
RestartSec=5

[Install]
WantedBy=sys-subsystem-net-devices-%i.device
